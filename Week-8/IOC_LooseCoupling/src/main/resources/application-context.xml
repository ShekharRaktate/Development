<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
<!-- bean definitions here -->
	<bean class="com.app.beans.BlueDart" id="blueDart"/>
	<bean class="com.app.beans.DTDC" id="dtdc"/>
	<bean class="com.app.beans.Ekart" id="e_kart"/>
	<bean class="com.app.beans.FlipKart" id="flipKart">
	<property name="courier" ref="blueDart"/>
	</bean>
</beans>