<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
          http://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
        version="3.2">
          <persistence-unit name="user">
          <class>com.app.domain.User</class>
          <class>com.app.domain.PhoneNumber</class>
          <properties>
         	<property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost/scdl"/>
			<property name="jakarta.persistence.jdbc.user" value="root"/>
           	<property name="jakarta.persistence.jdbc.password" value="1207"/>
          	<property name="hibernate.hbm2ddl.auto" value="update"/>
          	<property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
          	<property name="hibernate.show_sql" value="true"/>
          </properties>	
          
          </persistence-unit>
      </persistence>